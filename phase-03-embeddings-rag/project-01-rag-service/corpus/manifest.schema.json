{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceline.local/schemas/corpus-manifest.json",
  "title": "Sourceline corpus manifest",
  "description": "Deterministic inventory of the Markdown corpus at a given commit and embedding profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source_commit", "profile_key", "documents"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "description": "Git commit at ingest time, or \"unknown\" for a non-git checkout."
    },
    "profile_key": {
      "type": "string",
      "pattern": "^markdown-h2-v1\\|[0-9]+\\|[0-9]+\\|[^|]+\\|[0-9]+$",
      "examples": ["markdown-h2-v1|1200|150|text-embedding-3-small|1536"]
    },
    "root": {
      "type": "string",
      "description": "Corpus root as recorded by the ingester (absolute or relative)."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "title",
        "doc_type",
        "content_hash",
        "byte_size",
        "word_count",
        "line_count"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]+\\.md$",
          "description": "POSIX relative path, ending in .md, no backslashes or traversal.",
          "examples": ["phase-03-embeddings-rag/topic-25-pgvector/notes.md"],
          "allOf": [
            { "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
            { "not": { "pattern": "^/" } }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 4
        },
        "topic": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 64
        },
        "doc_type": {
          "type": "string",
          "enum": ["notes", "meta", "readme", "other"]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
