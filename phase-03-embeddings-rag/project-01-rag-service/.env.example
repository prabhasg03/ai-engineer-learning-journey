# Sourceline v1 configuration — copy to .env and fill the secrets.
# Never commit .env. Every value here is read by pydantic-settings at startup.
# The profile key is DERIVED from chunker/model/dimensions; do not set it manually.

# ── Core ─────────────────────────────────────────────────────────────────────
SOURCELINE_ENV=local
SOURCELINE_DATABASE_URL=postgresql://sourceline:sourceline@127.0.0.1:5432/sourceline
SOURCELINE_ADMIN_TOKEN=replace-with-a-long-random-token
SOURCELINE_QUERY_API_KEY=
SOURCELINE_PUBLIC_DEBUG=false
SOURCELINE_LOG_QUESTIONS=false
SOURCELINE_LOG_LEVEL=INFO
SOURCELINE_LOG_FORMAT=json

# ── Compose database credentials (used by the db service) ────────────────────
POSTGRES_USER=sourceline
POSTGRES_PASSWORD=sourceline
POSTGRES_DB=sourceline

# ── Providers (OpenAI-compatible) ────────────────────────────────────────────
SOURCELINE_OPENAI_API_KEY=
SOURCELINE_OPENAI_BASE_URL=https://api.openai.com/v1
SOURCELINE_EMBEDDING_MODEL=text-embedding-3-small
SOURCELINE_EMBEDDING_DIMENSIONS=1536
SOURCELINE_CHAT_MODEL=gpt-4.1-mini
SOURCELINE_CHAT_TEMPERATURE=0
SOURCELINE_CHAT_MAX_OUTPUT_TOKENS=500
SOURCELINE_EMBED_TIMEOUT_SECONDS=3
SOURCELINE_CHAT_TIMEOUT_SECONDS=20
SOURCELINE_PROVIDER_MAX_RETRIES=0
SOURCELINE_TOKENIZER_ENCODING=o200k_base

# Optional local profile (requires a schema dimension change + full reindex):
# SOURCELINE_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# SOURCELINE_EMBEDDING_MODEL=nomic-embed-text
# SOURCELINE_EMBEDDING_DIMENSIONS=768
# SOURCELINE_CHAT_MODEL=llama3.1:8b

# ── Retrieval / answer budget ────────────────────────────────────────────────
SOURCELINE_TOP_K=8
SOURCELINE_CANDIDATE_K=40
SOURCELINE_EF_SEARCH=80
SOURCELINE_SCORE_FLOOR=0.20
SOURCELINE_LEXICAL_FALLBACK=true
SOURCELINE_LEXICAL_SCORE_FLOOR=0.05
SOURCELINE_CONTEXT_BUDGET_TOKENS=6000
SOURCELINE_ANSWER_RESERVE_TOKENS=700
SOURCELINE_MAX_WORDS=200
SOURCELINE_REQUEST_DEADLINE_SECONDS=30

# ── Corpus / chunking ────────────────────────────────────────────────────────
# Local Python: ../.. ; Docker Compose overrides this to /corpus
SOURCELINE_CORPUS_ROOT=../..
SOURCELINE_SOURCE_BASE_URL=
SOURCELINE_EXPECTED_COMMIT=
SOURCELINE_MAX_INDEX_AGE_SECONDS=
SOURCELINE_CHUNKER_VERSION=markdown-h2-v1
SOURCELINE_CHUNK_TARGET_CHARS=1200
SOURCELINE_CHUNK_OVERLAP_CHARS=150
SOURCELINE_CHUNK_MAX_CHARS=1800
SOURCELINE_EMBED_BATCH_SIZE=64

# ── Ops / safety ─────────────────────────────────────────────────────────────
SOURCELINE_RATE_LIMIT_PER_MIN=60
SOURCELINE_RATE_LIMIT_BURST=10
SOURCELINE_QUERY_CONCURRENCY_PER_IP=5
SOURCELINE_QUERY_CONCURRENCY_GLOBAL=8
SOURCELINE_ADMIN_RATE_LIMIT_PER_MIN=10
SOURCELINE_MAX_BODY_BYTES=32768
SOURCELINE_DAILY_BUDGET_USD=0
SOURCELINE_TRUST_PROXY=false
SOURCELINE_CORS_ORIGINS=
SOURCELINE_DB_POOL_MIN=2
SOURCELINE_DB_POOL_MAX=10
SOURCELINE_RETRY_AFTER_CAP_SECONDS=30   # ingestion cap; query paths clamp to 10 s
SOURCELINE_CIRCUIT_FAILURE_THRESHOLD=5
SOURCELINE_CIRCUIT_OPEN_SECONDS=30
SOURCELINE_METRICS_ENABLED=true
SOURCELINE_OTEL_ENABLED=false

# ── Hosted-only reminders ────────────────────────────────────────────────────
# SOURCELINE_ENV=hosted
# SOURCELINE_PUBLIC_DEBUG=false
# SOURCELINE_DAILY_BUDGET_USD=5
# SOURCELINE_TRUST_PROXY=true
# SOURCELINE_CORS_ORIGINS=https://your-demo.example
